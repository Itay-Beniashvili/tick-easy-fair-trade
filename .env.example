# Copy this file to `.env` and fill in your Supabase project's values.
# `.env` is gitignored and must NEVER be committed.
#
# These three are SAFE to expose in the browser bundle:
#   - The publishable/anon key is public by design; Row Level Security (RLS)
#     enforces who can read/write. It is not a secret.
# NEVER put the service_role key, database password, or a personal access
# token (PAT) in this file or anywhere in the repo — those bypass RLS.

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
